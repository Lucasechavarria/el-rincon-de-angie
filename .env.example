# Backend Environment Variables

# Database
DATABASE_URL=postgresql://user:password@host:port/database
# For local development, use: sqlite:///./database.db

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Mercado Pago
MP_ACCESS_TOKEN=your-mercadopago-access-token
MP_PUBLIC_KEY=your-mercadopago-public-key

# Application URLs
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:8000
WEBHOOK_URL=https://your-domain.com/payments/webhook

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email Service (SendGrid or Resend)
EMAIL_SERVICE_API_KEY=your-email-service-api-key
EMAIL_FROM=noreply@elrincondeang ie.com
AUTHOR_EMAIL=author@elrincondeangie.com

# Optional: Redis for caching
REDIS_URL=redis://localhost:6379/0

# Environment
ENVIRONMENT=development
# Use 'production' for deployment
